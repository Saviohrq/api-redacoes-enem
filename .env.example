# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# --- Chaves dos provedores ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Modelos (use SEMPRE um identificador fixo, nunca "-latest") ---
ANTHROPIC_MODEL=claude-haiku-5-5
# Rode "python -m experimentos.listar_modelos_gemini" para ver os nomes disponíveis
GEMINI_MODEL=
# Llama roda localmente pelo Ollama (https://ollama.com). Ex.: llama3.2-vision:11b
OLLAMA_MODEL=llama3.2-vision:11b
OLLAMA_URL=http://localhost:11434

# Esforço de raciocínio do Claude (low, medium, high). Registrado em cada chamada.
ANTHROPIC_EFFORT=medium

# --- Corpus e RAG ---
# Pasta do repositório lplnufpi/essay-br clonado (contém extended-corpus/)
ESSAYBR_DIR=dados/essay-br
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
